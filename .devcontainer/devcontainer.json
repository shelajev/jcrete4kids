{
  "name": "JCrete4Kids LabSpace",
  "dockerComposeFile": "../compose.yaml",
  "service": "workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/jcrete4kids,type=bind,consistency=cached",
  "workspaceFolder": "/workspaces/jcrete4kids",
  "shutdownAction": "stopCompose",
  "forwardPorts": [
    "interface:3030",
    "workspace:8085"
  ],
  "portsAttributes": {
    "interface:3030": {
      "label": "LabSpace",
      "onAutoForward": "openBrowser"
    },
    "workspace:8085": {
      "label": "Workspace IDE",
      "onAutoForward": "notify"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "silent"
  }
}
